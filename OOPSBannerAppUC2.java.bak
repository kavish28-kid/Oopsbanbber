/**
 * OOPSBannerApp
 * UC2: Display OOPS in banner format using '*' and spaces
 * Each character is 7 lines and width ~9
 * 
 * @author Kavish
 * @version 2.0
 */
public class OOPSBannerApp {

    public static void main(String[] args) {

        // Line 1
        System.out.println(" *****     *****     ******    ***** ");
        // Line 2
        System.out.println("*     *   *     *    *     *  *     *");
        // Line 3
        System.out.println("*     *   *     *    *     *  *      ");
        // Line 4
        System.out.println("*     *   *     *    ******    ***** ");
        // Line 5
        System.out.println("*     *   *     *    *              *");
        // Line 6
        System.out.println("*     *   *     *    *        *     *");
        // Line 7
        System.out.println(" *****     *****     *         ***** ");
    }
}